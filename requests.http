### 2.2 ОПЕРАЦИЯ 1. Выставить предмет на торги (201, лот ACTIVE)
< {%
    request.variables.set("lotEnd", new Date(Date.now() + 7 * 24 * 3600 * 1000).toISOString());
%}
POST {{host}}/api/collectible-items/{{watchId}}/list-for-auction
Content-Type: application/json

{
  "startPrice": 1000,
  "step": 100,
  "endTime": "{{lotEnd}}"
}

> {%
    client.test("201, лот активен, начало задано сервером", function () {
        client.assert(response.status === 201);
        client.assert(response.body.status === "ACTIVE");
        client.assert(response.body.startTime !== undefined);
    });
    client.global.set("lotId", response.body.id);
%}

