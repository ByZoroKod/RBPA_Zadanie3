### 2.12 ОПЕРАЦИЯ 3. Завершить торги: побеждает A со ставкой 1300 (200, сделка PENDING, лот FINISHED)
POST {{host}}/api/auction-lots/{{lotId}}/close

> {%
    client.test("200, сделка на 1300, лот FINISHED", function () {
        client.assert(response.status === 200);
        client.assert(response.body.lot.status === "FINISHED");
        client.assert(response.body.deal.amount === 1300);
        client.assert(response.body.deal.transferStatus === "PENDING");
    });
    client.global.set("dealId", response.body.deal.id);
%}

