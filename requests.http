@host = http://localhost:8080

### 1.1 Пользователь: создать (201)
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Иван Продавцов",
  "email": "seller-{{$timestamp}}@example.com"
}

> {%
    client.test("201 и id", function () {
        client.assert(response.status === 201, "ожидали 201, получили " + response.status);
        client.assert(response.body.id > 0, "нет id");
    });
    client.global.set("sellerId", response.body.id);
    client.global.set("sellerEmail", response.body.email);
%}

### 1.2 Пользователь: список (200)
GET {{host}}/api/users

> {%
    client.test("200", function () { client.assert(response.status === 200); });
%}

### 1.3 Пользователь: по id (200)
GET {{host}}/api/users/{{sellerId}}

> {%
    client.test("200", function () { client.assert(response.status === 200); });
%}

### 1.4 Пользователь: обновить (200)
PATCH {{host}}/api/users/{{sellerId}}
Content-Type: application/json

{
  "name": "Иван Продавцов-Старший"
}

> {%
    client.test("200 и новое имя", function () {
        client.assert(response.status === 200);
        client.assert(response.body.name === "Иван Продавцов-Старший");
    });
%}

### 1.5 Пользователь: несуществующий id (404)
GET {{host}}/api/users/999999

> {%
    client.test("404", function () { client.assert(response.status === 404); });
%}

### 1.6 Пользователь: пустое имя (400)
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "   "
}

> {%
    client.test("400", function () { client.assert(response.status === 400); });
%}

### 1.7 Пользователь: повторный e-mail нарушает ограничение уникальности в БД (409)
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Двойник",
  "email": "{{sellerEmail}}"
}

> {%
    client.test("409", function () { client.assert(response.status === 409); });
%}

### 1.8 Предмет: создать (201)
POST {{host}}/api/collectible-items
Content-Type: application/json

{
  "description": "Серебряный рубль 1921 года",
  "ownerId": {{sellerId}},
  "condition": "хорошее"
}

> {%
    client.test("201 и id", function () {
        client.assert(response.status === 201);
        client.assert(response.body.id > 0);
    });
    client.global.set("itemId", response.body.id);
%}

### 1.9 Предмет: список (200)
GET {{host}}/api/collectible-items

> {%
    client.test("200", function () { client.assert(response.status === 200); });
%}

### 1.10 Предмет: по id (200)
GET {{host}}/api/collectible-items/{{itemId}}

> {%
    client.test("200", function () { client.assert(response.status === 200); });
%}

### 1.11 Предмет: обновить (200)
PATCH {{host}}/api/collectible-items/{{itemId}}
Content-Type: application/json

{
  "condition": "отличное"
}

> {%
    client.test("200 и новое состояние", function () {
        client.assert(response.status === 200);
        client.assert(response.body.condition === "отличное");
    });
%}

### 1.12 Предмет: владелец не существует, внешний ключ не даёт создать запись (400)
