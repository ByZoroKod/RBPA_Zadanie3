  "ownerId": 999999
}

> {%
    client.test("400", function () { client.assert(response.status === 400); });
%}

### 1.13 Лот: создать обычным CRUD (201)
< {%
    request.variables.set("crudEnd", new Date(Date.now() + 3 * 24 * 3600 * 1000).toISOString());
%}
POST {{host}}/api/auction-lots
Content-Type: application/json

{
  "itemId": {{itemId}},
  "startPrice": 100,
  "step": 10,
  "endTime": "{{crudEnd}}"
}

> {%
    client.test("201, статус ACTIVE", function () {
        client.assert(response.status === 201);
        client.assert(response.body.status === "ACTIVE");
    });
    client.global.set("crudLotId", response.body.id);
%}

### 1.14 Лот: список (200)
GET {{host}}/api/auction-lots

> {%
    client.test("200", function () { client.assert(response.status === 200); });
%}

