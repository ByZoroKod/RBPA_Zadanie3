  "lotId": {{crudLotId}},
  "winningBidId": {{crudBidId}}
}

> {%
    client.test("201, статус PENDING, сумма 100", function () {
        client.assert(response.status === 201);
        client.assert(response.body.transferStatus === "PENDING");
        client.assert(response.body.amount === 100);
    });
    client.global.set("crudDealId", response.body.id);
%}

